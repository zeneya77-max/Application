<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Application">

        <activity
            android:name=".SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.App.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:label="@string/app_name"
            android:theme="@style/Theme.Application" />

        <activity
            android:name=".SignUpActivity"
            android:exported="false"
            android:label="@string/sign_up"
            android:theme="@style/Theme.Application" />

        <activity
            android:name=".HomepageActivity"
            android:exported="false"
            android:label="@string/app_name"
            android:theme="@style/Theme.Application" />

        <activity
            android:name=".MySanctionsActivity"
            android:exported="false"
            android:label="@string/app_name"
            android:theme="@style/Theme.Application" />

        <activity
            android:name=".UnpaidSanctionsActivity"
            android:exported="false"
            android:label="@string/app_name"
            android:theme="@style/Theme.Application" />

        <activity
            android:name=".PaidSanctionsActivity"
            android:exported="false"
            android:label="@string/app_name"
            android:theme="@style/Theme.Application" />

        <activity
            android:name=".PayNowActivity"
            android:exported="false"
            android:label="Pay Now"
            android:theme="@style/Theme.Application" />

        <activity
            android:name=".ConfirmPaymentActivity"
            android:exported="false"
            android:label="Confirm Payment"
            android:theme="@style/Theme.Application" />

        <activity
            android:name=".GcashPaymentActivity"
            android:exported="false"
            android:label="GCash Payment"
            android:theme="@style/Theme.Application" />

        <activity
            android:name=".GcashOtpActivity"
            android:exported="false"
            android:label="Authentication"
            android:theme="@style/Theme.Application" />

        <activity
            android:name=".NotificationsActivity"
            android:exported="false"
            android:label="@string/app_name"
            android:theme="@style/Theme.Application" />

        <activity
            android:name=".ProfileActivity"
            android:exported="false"
            android:label="@string/nav_profile"
            android:theme="@style/Theme.Application" />

        <activity
            android:name=".PersonalInformationActivity"
            android:exported="false"
            android:label="@string/personal_info"
            android:theme="@style/Theme.Application" />

        <activity
            android:name=".RecentActivityActivity"
            android:exported="false"
            android:label="@string/recent_activity"
            android:theme="@style/Theme.Application" />

        <activity
            android:name=".CouncilLoginActivity"
            android:exported="false"
            android:label="@string/council_login"
            android:theme="@style/Theme.Application" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.provider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>